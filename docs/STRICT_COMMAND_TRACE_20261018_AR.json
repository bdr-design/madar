  "trace_findings": [
    "أظهر أخذ عينات CPU أن إعادة بناء النص القانوني للمستند وفرز مفاتيحه واستدعاءات ترميزها كانت أكبر من حساب SHA-256 وحده في دفعة الشيكات النموذجية. ملفات profiler تتضمن كلفة الأداة ولا تُستخدم كقياس زمن اللعبة.",
    "كان تعديل المستند يعيد ترميز المادة قبل التعديل وبعده، ثم يعيد تجهيز مادة ما بعد التعديل مرة أخرى عند إنشاء الإثبات الجديد.",
    "تجهيز القائمة القانونية لأسماء الحقول كان يعيد ترتيبها وتهيئة كل مفتاح على حدة، رغم تكرار البنية. القيم نفسها يجب أن تبقى مقروءة ومتحققة في كل استدعاء.",
    "تتبع أزرار الواجهة أكد فصل النسخ والفحص والحفظ وACK والنشر. حُجز ACK عمدًا لاختبار السببية: لم تُنشر الأرصدة أو المستندات أو الإثباتات أو التراخيص قبل وصوله.",
    "التقاط CPU للمتصفح أظهر أيضًا كلفة في openDrawer والنسخ والترميز وإعداد العرض. العينة تشمل عدة إجراءات ومراقبة الاختبار؛ لا تُحوَّل إلى زمن خاص بالآيفون أو إلى سبب وحيد لكل تقطيع."
  ],
  "fixes": [
    {
      "file": "WebApp/authorization-core.js",
      "change": "إعادة استخدام ترتيب أسماء الحقول وصيغتها النصية ضمن فهرس محدود، واستبدال map لكل خاصية بحلقة مباشرة. مفتاح الفهرس هو النص الكامل لقائمة الأسماء، دون احتمال اصطدام بصمة.",
      "preserved": "قراءة القيم من جديد، ترتيب المفاتيح النصي، معالجة الأرقام و-0، التحقق من الأنواع والدورات، ترتيب قراءة getters، ونفس النص القانوني حرفيًا. لا تخزين لقرار تحقق أو قيمة مستند.",
      "fallbacks": "البنى فوق 128 خاصية أو أسماء تتجاوز 2048 وحدة خام أو مفتاح فهرسة فوق 8192 وحدة لا تُحتفظ بها. تُحذف الخطط القديمة عند بلوغ الميزانية، ويُمسح الفهرس عند تغير دالة JSON.stringify."
    },
    {
      "file": "WebApp/document-proof-core.js",
      "change": "إرجاع النص القانوني الذي حُسب بالفعل من خطوة تجهيز المادة، وإعادة استخدام لقطة المادة المفحوصة بعد التعديل داخل الاستدعاء المتزامن نفسه.",
      "preserved": "كل فحوص المستند السابق والتوقيع وسلسلة الإثبات والتلاعب والحجم والعمق وهوية المستند والشركة باقية. الدالة العامة signedContent لا تقبل شهادة لتجاوز التجهيز؛ إعادة الاستخدام خاصة بالمالك فقط.",
      "fallbacks": "الخصائص المحسوبة في المستند أو العناصر المتداخلة أو المصفوفة تُبقي التجهيز الجديد. لا إعادة استخدام عبر yield أو بين الأوامر. يبقى الرجوع بعد الإلغاء والخطأ وبعد نقل سجل إلى الأرشيف مطابقًا."
    }
  ],
